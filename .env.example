# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  (legacy, see SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin setup (create this user in Supabase Auth dashboard first)
# Then sign in with email/password on the /admin login page
# VITE_ADMIN_EMAIL=admin@droguerie-souss.ma

# Verrou d'accès du site (username/password plein écran).
# =false (ou variable absente) → site OUVERT au public et aux crawlers SEO.
# =true → site VERROUILLÉ (demande les identifiants de la table site_gate_users).
# Pensez à définir la même valeur côté Vercel (Environment Variables).
VITE_SITE_GATE_ENABLED=false

# Google Analytics 4 (facultatif) : mesure d'audience du site.
# Créez une propriété GA4, récupérez l'ID "G-XXXXXXX" et collez-le ici
# (ou dans les variables d'environnement Vercel). Sans lui, aucune balise
# GA4 n'est injectée et le site fonctionne normalement.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

